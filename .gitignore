node_modules
dist
.DS_Store
*.log
.vite
# Original art (3D models, concept sheets, source textures) lives in art/ but is too big for git:
# only its README is tracked. Back the folder up separately (see art/README.md).
art/*
!art/README.md

# Blender files anywhere else, backups and raw render frames
*.blend
*.blend1
tools/blender/frames

# Blender caches (smoke / steam simulations)
*_cache*

# Monorepo / test output
.turbo
test-results
playwright-report
# simulator reports (npm run simulate)
tools/simulator/out

# Private notes for Claude (never committed)
CLAUDE.md
.playwright-mcp

# local secrets (API keys): never committed; .env.example lists them
.env
.env.*
!.env.example

# Game assets (sprites, previews, audio, music...): on S3, not in git. npm run assets:pull downloads them,
# npm run assets:push uploads a new version (tools/assets/assets.mjs, apps/game/assets.json).
apps/game/public/assets

# Claude Code: agent worktrees and personal settings
.claude/worktrees
.claude/settings.local.json
