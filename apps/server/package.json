{
  "name": "@gravity-harvest/server",
  "version": "0.1.0",
  "private": true,
  "description": "Game server for Gravity Harvest: runs matches (WebSocket) and stores saves",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@gravity-harvest/ai": "*",
    "@gravity-harvest/shared": "*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/typeorm": "^12.0.2",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "@gravity-harvest/sim": "*",
    "@gravity-harvest/rules": "*",
    "ws": "^8.18.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
