# Copy to .env (gitignored) and fill in: the asset tools read their API keys from there.

# ElevenLabs: sound effects, music and voice lines (tools/audio). Create a key at
# https://elevenlabs.io/app/settings/api-keys with Sound Effects, Music and Text to Speech allowed.
# Anything generated on the free plan may not go in a released game.
ELEVENLABS_API_KEY=

# Google Gemini API: Veo video generation (the buildings' generated videos, tools/sprites/key_video.py).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alibaba Cloud Model Studio (international, dashscope-intl.aliyuncs.com): Wan 3.0 video generation (trailer).
# https://modelstudio.console.alibabacloud.com
DASHSCOPE_API_KEY=
